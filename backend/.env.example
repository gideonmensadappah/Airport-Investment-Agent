APP_NAME="Airport Investment Agent API"
API_PREFIX="/api/v1"
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL="https://aerodatabox.p.rapidapi.com"
AERODATABOX_RAPIDAPI_HOST="aerodatabox.p.rapidapi.com"
AERODATABOX_TIMEOUT_SECONDS=3
USE_AERODATABOX=true
LONG_HAUL_THRESHOLD_MILES=3000
CORS_ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
AIRPORT_DATABASE_FILE="../data/airport_data.db"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-5-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_SECONDS=30
USE_OPENAI=true
